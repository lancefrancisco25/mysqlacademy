# MySQL Academy Environment Variables
# Copy this file to .env.local for local development, or add these to your Vercel Project Settings.

# Supabase URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
